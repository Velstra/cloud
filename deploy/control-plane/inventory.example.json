{
  "cell": "cell-1",
  "region": "eu-central",
  "ssh": {
    "user": "root",
    "privateKey": "/secure/path/control-plane-deploy-key"
  },
  "etcd": {
    "scheme": "https",
    "ca": "/secure/path/etcd-ca.pem"
  },
  "api": {
    "caPath": "/etc/velstra/api-ca.pem",
    "nodeRegistration": {
      "url": "https://cp01.example.net:8443",
      "ca": "/secure/path/api-ca.pem",
      "adminTokenFile": "/secure/path/deployment-admin-token",
      "agentUrl": "https://cloud-api.internal.example.net:8443"
    }
  },
  "controlPlanes": [
    {
      "name": "cp01",
      "address": "10.42.0.10",
      "sshAddress": "10.42.0.10",
      "etcdCertificate": "/secure/path/cp01-etcd.pem",
      "etcdPrivateKey": "/secure/path/cp01-etcd-key.pem"
    },
    {
      "name": "cp02",
      "address": "10.42.0.11",
      "sshAddress": "10.42.0.11",
      "etcdCertificate": "/secure/path/cp02-etcd.pem",
      "etcdPrivateKey": "/secure/path/cp02-etcd-key.pem"
    },
    {
      "name": "cp03",
      "address": "10.42.0.12",
      "sshAddress": "10.42.0.12",
      "etcdCertificate": "/secure/path/cp03-etcd.pem",
      "etcdPrivateKey": "/secure/path/cp03-etcd-key.pem"
    }
  ]
}
